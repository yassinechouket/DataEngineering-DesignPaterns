# Local development environment for docker-compose.
# Fill in real values below — do not commit real credentials/bucket names
# if this repo is public.

# Airflow
AIRFLOW_UID=50000
FERNET_KEY=

# AWS
S3_BUCKET=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Only needed if you're not using a mounted ~/.aws profile (see
# docker-compose.yml). Leave blank to use the mounted credentials file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# Embeddings
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
